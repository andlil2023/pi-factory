{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rendered UI Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "taskId", "attempt", "capturedAt", "sourceFingerprint", "application", "checks", "artifacts", "limitations"],
  "properties": {
    "version": { "const": 1 },
    "taskId": { "type": "string", "pattern": "^T[0-9]{3,}$" },
    "attempt": { "type": "integer", "minimum": 1 },
    "capturedAt": { "type": "string", "minLength": 1 },
    "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "application": {
      "type": "object", "additionalProperties": false,
      "required": ["framework", "buildId"],
      "properties": { "framework": { "type": "string", "minLength": 1 }, "buildId": { "type": "string", "minLength": 1 } }
    },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "name", "status"],
        "properties": {
          "kind": { "enum": ["interaction", "accessibility"] },
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed"] },
          "details": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": { "enum": ["screenshot", "accessibility-tree", "log"] },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "imageLinks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["checkName", "screenshotPath", "caption"],
        "properties": {
          "checkName": { "type": "string", "minLength": 1 },
          "screenshotPath": { "type": "string", "minLength": 1 },
          "caption": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
