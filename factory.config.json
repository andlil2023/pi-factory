{
  "agents": {
    "planner": {
      "provider": "openai-codex",
      "model": "gpt-6.1-terra",
      "timeoutMs": 300000
    },
    "implementer": {
      "provider": "openai-codex",
      "model": "gpt-6.1-terra",
      "timeoutMs": 600000
    },
    "reviewer": {
      "provider": "openai-codex",
      "model": "gpt-6.1-sol",
      "timeoutMs": 300000
    }
  },
  "reviewRouting": "task-specific",
  "reviewers": {
    "security": {
      "provider": "openai-codex",
      "model": "gpt-6.1-sol",
      "timeoutMs": 300000
    },
    "ui": {
      "provider": "openai-codex",
      "model": "gpt-6.1-terra",
      "timeoutMs": 300000
    }
  },
  "execution": {
    "maxAttempts": 3,
    "requireApprovalBeforeExecution": true
  },
  "setup": [
    {
      "executable": "cmd",
      "args": [
        "/c",
        "npm",
        "ci",
        "--ignore-scripts",
        "--no-audit",
        "--no-fund"
      ],
      "timeoutMs": 600000
    }
  ],
  "verification": [
    {
      "executable": "node",
      "args": [
        "--test"
      ],
      "timeoutMs": 120000
    }
  ]
}
