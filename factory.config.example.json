{
  "agents": {
    "planner": {
      "provider": "openai",
      "model": "REPLACE_WITH_PI_MODEL_ID"
    },
    "implementer": {
      "provider": "openai",
      "model": "REPLACE_WITH_PI_MODEL_ID"
    },
    "reviewer": {
      "provider": "openai",
      "model": "REPLACE_WITH_PI_MODEL_ID"
    }
  },
  "reviewRouting": "task-specific",
  "reviewers": {
    "security": {
      "provider": "openai",
      "model": "REPLACE_WITH_PI_MODEL_ID",
      "timeoutMs": 300000
    },
    "ui": {
      "provider": "openai",
      "model": "REPLACE_WITH_PI_MODEL_ID",
      "timeoutMs": 300000
    }
  },
  "execution": {
    "maxAttempts": 3,
    "maxInfraRetries": 1,
    "verificationReruns": 1,
    "maxAutoReplans": 2
  },
  "planning": {
    "maxReviewRounds": 2
  },
  "setup": [
    {
      "executable": "cmd",
      "args": [
        "/c",
        "npm",
        "ci",
        "--ignore-scripts",
        "--no-audit",
        "--no-fund"
      ],
      "timeoutMs": 600000
    }
  ],
  "verification": [
    {
      "executable": "node",
      "args": ["node_modules/typescript/bin/tsc", "--noEmit"],
      "timeoutMs": 120000
    },
    {
      "executable": "node",
      "args": ["--experimental-strip-types", "--test", "tests/*.test.ts"],
      "timeoutMs": 600000
    }
  ]
}
